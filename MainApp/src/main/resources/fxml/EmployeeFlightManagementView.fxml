<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<VBox spacing="10.0" prefHeight="650.0" prefWidth="900.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.aeroport.view.EmployeeFlightManagementView">

    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <HBox spacing="15" alignment="CENTER_LEFT">
        <Label text="%employee.search.label">
            <font><Font name="System Bold" size="13.0" /></font>
        </Label>
        <TextField fx:id="txtCautare" promptText="%employee.search.prompt" prefWidth="150"/>
        <Button text="%flight.search" onAction="#onCautaClick" style="-fx-background-color: #3498db; -fx-text-fill: white;"/>
        <Button text="%employee.btn.all_flights" onAction="#onArataToateClick" style="-fx-background-color: #95a5a6; -fx-text-fill: white;"/>

        <Region HBox.hgrow="ALWAYS" />

        <Button fx:id="btnVizualizeaza" text="%employee.btn.view_flight" onAction="#onVizualizeazaClick"
                style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold;" disable="true"/>
    </HBox>

    <HBox spacing="15" alignment="CENTER_LEFT">
        <Label text="%export.format.label">
            <font><Font name="System Bold" size="13.0" /></font>
        </Label>
        <ComboBox fx:id="cmbExportFormat" prefWidth="100" style="-fx-background-color: white; -fx-border-color: #bdc3c7;"/>
        <Button fx:id="btnExport" text="%export.btn.tickets" onAction="#onExportClick"
                style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-font-weight: bold;" disable="true"/>
    </HBox>

    <TableView fx:id="tblZboruri" VBox.vgrow="ALWAYS" style="-fx-border-color: #bdc3c7;">
        <columns>
            <TableColumn fx:id="colId" text="%employee.col.id" prefWidth="50" visible="false"/>
            <TableColumn fx:id="colNumar" text="%flight.column.number" prefWidth="100"/>
            <TableColumn fx:id="colPlecare" text="%flight.column.departure" prefWidth="150"/>
            <TableColumn fx:id="colSosire" text="%flight.column.arrival" prefWidth="150"/>
            <TableColumn fx:id="colOraDecolare" text="%flight.column.departure_time" prefWidth="120"/>
            <TableColumn fx:id="colOraAterizare" text="%flight.column.arrival_time" prefWidth="120"/>
            <TableColumn fx:id="colPret" text="%flight.column.price" prefWidth="100"/>
            <TableColumn fx:id="colLocuri" text="%flight.column.seats" prefWidth="100"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <Label fx:id="lblEroare" textFill="#e74c3c" managed="false" visible="false">
        <font><Font name="System Italic" size="12.0" /></font>
    </Label>
</VBox>