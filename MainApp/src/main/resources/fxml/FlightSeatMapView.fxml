<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.aeroport.view.FlightSeatMapView">

    <top>
        <VBox alignment="CENTER" style="-fx-background-color: #34495e; -fx-padding: 15;">
            <Label fx:id="lblDetaliiZbor" text="-" textFill="WHITE">
                <font><Font name="System Bold" size="18.0" /></font>
            </Label>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-padding: 20;">
            <VBox alignment="TOP_CENTER" spacing="20">
                <Label text="%seatmap.front" textFill="#7f8c8d"/>
                <GridPane fx:id="gridLocuri" hgap="10" vgap="10" alignment="CENTER">
                </GridPane>
                <Label text="%seatmap.back" textFill="#7f8c8d"/>
            </VBox>
        </ScrollPane>
    </center>

    <right>
        <VBox spacing="15" prefWidth="300" style="-fx-background-color: #ecf0f1; -fx-padding: 20; -fx-border-color: #bdc3c7; -fx-border-width: 0 0 0 1;">
            <Label text="%seatmap.details.title" textFill="#2c3e50">
                <font><Font name="System Bold" size="16.0" /></font>
            </Label>
            <Separator/>
            <VBox spacing="5">
                <Label text="%seatmap.details.seat">
                    <font><Font name="System Bold" size="12.0" /></font>
                </Label>
                <TextField fx:id="txtLoc" editable="false" style="-fx-background-color: #e0e0e0; -fx-font-weight: bold;"/>
            </VBox>
            <VBox spacing="5">
                <Label text="%seatmap.details.name"/>
                <TextField fx:id="txtNumePasager" promptText="%seatmap.details.name.prompt"/>
            </VBox>
            <VBox spacing="5">
                <Label text="%seatmap.details.price"/>
                <TextField fx:id="txtPret" editable="false" style="-fx-background-color: #e0e0e0;"/>
            </VBox>
            <VBox spacing="5">
                <Label text="%seatmap.details.date"/>
                <TextField fx:id="txtDataVanzare" editable="false" style="-fx-background-color: #e0e0e0;"/>
            </VBox>

            <Label fx:id="lblStatus" textFill="#e74c3c" wrapText="true">
                <font><Font name="System Italic" size="12.0" /></font>
            </Label>
            <Separator/>

            <Button fx:id="btnVanzare" text="%seatmap.btn.sell" onAction="#onVindeBilet" maxWidth="Infinity"
                    style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold;"/>
            <Button fx:id="btnActualizare" text="%seatmap.btn.update" onAction="#onActualizeazaBilet" maxWidth="Infinity"
                    style="-fx-background-color: #f39c12; -fx-text-fill: white;"/>
            <Button fx:id="btnAnulare" text="%seatmap.btn.cancel" onAction="#onAnuleazaBilet" maxWidth="Infinity"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
            <Separator/>
            <Button fx:id="btnExportPDF" text="%seatmap.btn.print_pdf" onAction="#onExportPDF" maxWidth="Infinity"
                    style="-fx-background-color: #9b59b6; -fx-text-fill: white;"/>
        </VBox>
    </right>
</BorderPane>